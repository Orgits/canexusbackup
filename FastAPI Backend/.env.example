ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-min-32-chars
DATABASE_URL=postgresql+asyncpg://ca_nexus:your_password@localhost:5432/ca_nexus
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
LOG_LEVEL=DEBUG
LOG_FORMAT=console
ENABLE_METRICS=true