# Staging Environment Configuration
# Copy this file to .env.staging and fill in actual values
# NEVER commit real secrets to version control

ENVIRONMENT=staging
DEBUG=false
SECRET_KEY=your-staging-secret-key-min-32-chars-generated-securely
DATABASE_URL=postgresql+asyncpg://ca_nexus:your_staging_password@your-staging-db-host:5432/ca_nexus_staging
REDIS_URL=redis://your-staging-redis-host:6379/0
CORS_ORIGINS=["https://staging.yourdomain.com"]
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true

# SMTP Configuration (optional)
SMTP_HOST=your-staging-smtp-host
SMTP_PORT=587
SMTP_USER=your-staging-smtp-user
SMTP_PASSWORD=your-staging-smtp-password
SMTP_TLS=true
EMAIL_FROM=noreply@staging.yourdomain.com

# Azure Blob Storage (optional)
AZURE_BLOB_CONNECTION_STRING=your-staging-azure-blob-connection-string
AZURE_BLOB_CONTAINER=ca-nexus-documents-staging

# Celery
CELERY_BROKER_URL=redis://your-staging-redis-host:6379/1
CELERY_RESULT_BACKEND=redis://your-staging-redis-host:6379/2