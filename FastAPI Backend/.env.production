# Production Environment Configuration
# Copy this file to .env.production and fill in actual values
# NEVER commit real secrets to version control
# Use a secrets manager in production (AWS Secrets Manager, HashiCorp Vault, etc.)

ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your-production-secret-key-min-32-chars-generated-securely
DATABASE_URL=postgresql+asyncpg://ca_nexus:your_production_password@your-production-db-host:5432/ca_nexus
REDIS_URL=redis://your-production-redis-host:6379/0
CORS_ORIGINS=["https://yourdomain.com"]
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]
LOG_LEVEL=WARNING
LOG_FORMAT=json
ENABLE_METRICS=true

# SMTP Configuration
SMTP_HOST=your-production-smtp-host
SMTP_PORT=587
SMTP_USER=your-production-smtp-user
SMTP_PASSWORD=your-production-smtp-password
SMTP_TLS=true
EMAIL_FROM=noreply@yourdomain.com

# Azure Blob Storage
AZURE_BLOB_CONNECTION_STRING=your-production-azure-blob-connection-string
AZURE_BLOB_CONTAINER=ca-nexus-documents

# Celery
CELERY_BROKER_URL=redis://your-production-redis-host:6379/1
CELERY_RESULT_BACKEND=redis://your-production-redis-host:6379/2

# Security: Ensure these are set in production
# - Use a proper secrets manager
# - Enable SSL/TLS for database connections
# - Restrict database access via security groups/firewall
# - Rotate secrets regularly
# - Monitor audit logs